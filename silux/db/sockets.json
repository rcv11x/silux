  "soldered_brands": {
    "about": "Un modelo de Intel terminado en U, en Y o en G y una cifra (1035G4) va soldado, sea cual sea su generación.",
    "GenuineIntel": ["\\d{4,5}(U|Y|G\\d)\\s", "\\dY\\d{2}\\s", "-L\\d{2}G\\d"]
  },
